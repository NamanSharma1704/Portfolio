# Copy to .env.local and fill in. Both are optional. The site runs without them.

# Web3Forms access key for the contact form. When unset, the route falls back
# to the key that was previously shipped in the client bundle.
WEB3FORMS_ACCESS_KEY=

# Canonical origin, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://portfolio-naman-17.vercel.app
